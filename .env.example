# ── Claude API ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modell: Opus 4.8 (Standard, stärkste Qualität). Für günstigere/schnellere
# Läufe z.B. claude-sonnet-4-6 setzen.
CLAUDE_MODEL=claude-opus-4-8

# ── Microsoft Entra ID (Azure AD) Service Principal ───────────
# App-Registrierung im Entra-Portal, mit Zugriff auf den Power-BI-Workspace.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
PBI_CLIENT_ID=00000000-0000-0000-0000-000000000000
PBI_CLIENT_SECRET=your-client-secret

# ── Power BI Ziel ─────────────────────────────────────────────
# Workspace- und Dataset-(Semantic-Model-)IDs aus der Power-BI-URL.
PBI_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
PBI_DATASET_ID=00000000-0000-0000-0000-000000000000

# ── Web-Login (Entra SSO) ─────────────────────────────────────
# Zufälliger, langer String zum Signieren des Session-Cookies.
SESSION_SECRET=bitte-langen-zufallsstring-eintragen
# Muss exakt so als Redirect-URI (Typ Web) in der App-Registrierung stehen.
REDIRECT_URI=http://localhost:8000/auth/callback
# Optional: nur diese E-Mails zulassen (kommagetrennt). Leer = ganzer Tenant.
ALLOWED_USERS=

# ── Addison / MS SQL (Variante C) ─────────────────────────────
# Read-only-Zugang zur Addison-Replik. Leer = SQL-Import deaktiviert.
ADDISON_SQL_SERVER=x.x.x.x
ADDISON_SQL_PORT=1433
ADDISON_SQL_DATABASE=AlleMandanten
ADDISON_SQL_USER=dein-readonly-login
ADDISON_SQL_PASSWORD=dein-passwort

# Gesamtmodell (1:1-Abbild des Addison-Schemas, alle Tabellen + FK-Beziehungen,
# ohne KI). Name des Semantic Models im Workspace.
ADDISON_MODEL_NAME=Addison Gesamtmodell
# true = beim App-Start automatisch anlegen, falls noch nicht vorhanden
# (idempotent, nicht blockierend). false = nicht automatisch anlegen.
ADDISON_AUTO_MODEL=true

# ── EC2/Caddy-Deployment ──────────────────────────────────────
# Subdomain, unter der die App läuft (Caddy holt dafür das HTTPS-Zertifikat).
APP_DOMAIN=powerbi.eure-domain.de
# Muss zur APP_DOMAIN passen und in der Entra-App-Registrierung stehen:
# REDIRECT_URI=https://powerbi.eure-domain.de/auth/callback
